// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Status {
  on_leave
  resigned
  active
}

enum EmploymentStatus {
  permanent
  contract
  probation
  intern
}

enum UserRole {
  admin
  executive
  management
  user
}

enum LeaveApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(user)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employeeId   Employee?
}

model Employee {
  id         Int               @id @default(autoincrement())
  nik        String            @unique
  fullName   String
  hireDate   DateTime
  status     Status
  salary     Int
  employment EmploymentStatus?

  user   User? @relation(fields: [userId], references: [id])
  userId Int?  @unique

  department   Department? @relation("DepartmentEmployees", fields: [departmentId], references: [id])
  departmentId Int?

  leadOf Department? @relation("DepartmentLead")

  positionId Int
  position   Position @relation(fields: [positionId], references: [id])

  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
}

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  employees Employee[] @relation("DepartmentEmployees")

  positions Position[]

  lead   Employee? @relation("DepartmentLead", fields: [leadId], references: [id])
  leadId Int?      @unique
}

model Position {
  id    Int    @id @default(autoincrement())
  title String

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  employees Employee[]
}

model LeaveType {
  id           Int    @id @default(autoincrement())
  name         String
  defaultQuota Int
  code         String @unique

  balances LeaveBalance[]
  requests LeaveRequest[]
}

model LeaveRequest {
  id          Int                 @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  startDate   DateTime
  endDate     DateTime
  days        Int
  status      LeaveApprovalStatus @default(PENDING)
  reason      String
  createdAt   DateTime            @default(now())

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
}

model LeaveBalance {
  id          Int @id @default(autoincrement())
  employeeId  Int
  leaveTypeId Int
  year        Int
  quota       Int
  used        Int

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId])
}
